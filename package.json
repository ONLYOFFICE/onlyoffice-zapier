{
  "name": "onlyoffice-zapier",
  "version": "1.1.1",
  "description": "This integration allows users to create their own DocSpace integration",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ONLYOFFICE/onlyoffice-zapier/issues",
    "email": "support@onlyoffice.com"
  },
  "homepage": "https://www.onlyoffice.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ONLYOFFICE/onlyoffice-zapier.git"
  },
  "author": "Ascensio System SIA <integration@onlyoffice.com> (https://www.onlyoffice.com)",
  "maintainers": [
    "Ascensio System SIA <integration@onlyoffice.com> (https://www.onlyoffice.com)"
  ],
  "keywords": [
    "onlyoffice",
    "docspacec"
  ],
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "all": "node ./makefile.js all",
    "build": "node ./makefile.js build",
    "check": "tsc",
    "install-lefthook": "node ./makefile.js install-lefthook",
    "install-zapier": "node ./makefile.js install-zapier",
    "lint": "eslint .",
    "promote": "node ./makefile.js promote",
    "release": "node ./makefile.js release",
    "setup-env": "node ./makefile.js setup-env",
    "test": "uvu app ^.*\\.test\\.js$",
    "tt": "node ./makefile.js tt",
    "upload": "node ./makefile.js upload"
  },
  "dependencies": {
    "content-disposition": "^0.5.4",
    "form-data": "^4.0.6",
    "normalize-url": "6.1.0",
    "zapier-platform-core": "19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@stylistic/eslint-plugin-js": "^1.4.1",
    "@types/content-disposition": "^0.5.8",
    "esbuild": "^0.28.1",
    "eslint": "^8.53.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.0.2",
    "eslint-plugin-require-sort": "^1.3.0",
    "globals": "^13.24.0",
    "lefthook": "^2.1.9",
    "nock": "^13.3.8",
    "sade": "^1.8.1",
    "typescript": "^5.2.2",
    "uvu": "^0.5.6"
  },
  "packageManager": "pnpm@8.10.4",
  "engines": {
    "node": "22.12.0"
  }
}
